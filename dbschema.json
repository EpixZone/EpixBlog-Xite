{
	"db_name": "EpixBlog",
	"db_file": "data/epixblog.db",
	"version": 3,
	"maps": {
		"users/.+/comments.json": {
			"to_table": [ {"node": "post", "table": "comment"} ],
			"file_name": "data.json",
			"fold_crdt": "post"
		},
		"users/.+/comment_votes.json": {
			"to_table": [ {"node": "post", "table": "comment_vote"} ],
			"file_name": "data.json",
			"fold_crdt": "post"
		},
		"users/.+/post_votes.json": {
			"to_table": [ {"node": "post", "table": "post_vote"} ],
			"file_name": "data.json",
			"fold_crdt": "post"
		},
		"users/.+/content.json": {
			"to_keyvalue": [ "cert_user_id" ]
		},
		"data.json": {
			"to_table": [ "post" ],
			"to_keyvalue": [ "title", "description", "links", "next_post_id", "demo", "modified" ]
		}

	},
	"tables": {
		"comment": {
			"cols": [
				["post_id", "INTEGER"],
				["blog_post_id", "INTEGER"],
				["body", "TEXT"],
				["date_added", "INTEGER"],
				["json_id", "INTEGER REFERENCES json (json_id)"]
			],
			"indexes": ["CREATE UNIQUE INDEX comment_key ON comment(json_id, post_id)", "CREATE INDEX comment_blog_post_id ON comment(blog_post_id)", "CREATE INDEX comment_post_id ON comment(post_id)"],
			"schema_changed": 1752940000
		},
		"comment_vote": {
			"cols": [
				["comment_uri", "TEXT"],
				["vote", "INTEGER"],
				["json_id", "INTEGER REFERENCES json (json_id)"]
			],
			"indexes": ["CREATE INDEX comment_vote_comment_uri ON comment_vote(comment_uri)", "CREATE INDEX comment_vote_json_id ON comment_vote(json_id)"],
			"schema_changed": 1426195822
		},
		"post": {
			"cols": [
				["post_id", "INTEGER"],
				["title", "TEXT"],
				["body", "TEXT"],
				["date_published", "INTEGER"],
				["json_id", "INTEGER REFERENCES json (json_id)"]
			],
			"indexes": ["CREATE UNIQUE INDEX post_uri ON post(json_id, post_id)", "CREATE INDEX post_id ON post(post_id)"],
			"schema_changed": 1426195823
		},
		"post_vote": {
			"cols": [
				["post_id", "INTEGER"],
				["vote", "INTEGER"],
				["json_id", "INTEGER REFERENCES json (json_id)"]
			],
			"indexes": ["CREATE INDEX post_vote_post_id ON post_vote(post_id)", "CREATE INDEX post_vote_json_id ON post_vote(post_id)"],
			"schema_changed": 1426195826
		}
	},
	"feeds": {
		"Comments": "SELECT 'comment' AS type, date_added, post.title AS title, keyvalue.value || ': ' || comment.body AS body, '?Post:' || comment.blog_post_id || '#Comments' AS url FROM comment LEFT JOIN json USING (json_id) LEFT JOIN json AS json_content ON (json_content.directory = json.directory AND json_content.file_name='content.json') LEFT JOIN keyvalue ON (keyvalue.json_id = json_content.json_id AND key = 'cert_user_id') LEFT JOIN post ON (comment.blog_post_id = post.post_id)",
		"Posts": "SELECT post_id AS event_uri, 'post' AS type, date_published AS date_added, title AS title, body AS body, '?Post:' || post_id AS url FROM post"
	}
}
